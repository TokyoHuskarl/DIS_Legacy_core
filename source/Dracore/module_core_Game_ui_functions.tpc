__fn get_unit_icon_path_to_regs1 $unitid {
	func_get_troopinfo_from_csv($unitid) // inefficient as fugg, need to be changed
	regs1.asg CSVELM_AGENT_iconsprite
}

__fn get_tech_icon_path_to_regs1 $techid {
	regs1.asg "0" // kari
}

